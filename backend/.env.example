# RESILIENCE Platform - Backend Environment Configuration Template
PROJECT_NAME=RESILIENCE
PROJECT_DESCRIPTION="RESILIENCE AI - An AI-Powered Multi-Agent Platform for Emergency Response, Resource Coordination & Dynamic Replanning"
API_V1_STR=/api/v1

# Security & Cryptography
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=resilience_db

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# WhatsApp / Meta Cloud API
WHATSAPP_PROVIDER=meta_cloud
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Gemini
GEMINI_API_KEY=

# Google Maps / Places / Routes
GOOGLE_MAPS_API_KEY=
