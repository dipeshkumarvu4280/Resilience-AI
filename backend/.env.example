# RESILIENCE Platform - Backend Environment Configuration Template
PROJECT_NAME=RESILIENCE
PROJECT_DESCRIPTION="RESILIENCE AI - An AI-Powered Multi-Agent Platform for Emergency Response, Resource Coordination & Dynamic Replanning"
API_V1_STR=/api/v1
CORS_ALLOWED_ORIGINS=https://resilience-ai-pied.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Security & Cryptography
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=resilience_db

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# WhatsApp Provider Selection: meta_cloud, twilio, mock, or disabled
WHATSAPP_PROVIDER=twilio
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Twilio WhatsApp Sandbox Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_ENABLED=true
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=
TWILIO_VALIDATE_SIGNATURE=true

# Twilio SMS Configuration
SMS_PROVIDER=disabled
TWILIO_SMS_ENABLED=false
TWILIO_SMS_FROM=
TWILIO_SMS_STATUS_CALLBACK_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_TEXT_MODEL=gpt-5.6-luna

# Gemini
GEMINI_API_KEY=

# Google Maps / Places / Routes
GOOGLE_MAPS_API_KEY=
